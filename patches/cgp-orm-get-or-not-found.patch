 /// Fetch a resource by primary key and encode it.
+///
+/// A missing row is `Ok(None)` — success, not
+/// [`crate::error::ErrEntityNotFound`]. The default provider never raises
+/// that error. To turn a missing row into `ErrEntityNotFound` (for example
+/// so a REST map can answer 404), use the opt-in
+/// [`CanGetResourceOrNotFound::get_or_not_found`]. Do not change `get`.
 #[cgp_component(GetResource)]
 #[cgp_async(Send)]
 #[use_type(HasEntityType.Entity, HasErrorType.Error, HasOutputType.Output)]
@@ -107,6 +113,38 @@ pub trait CanGetResource {
     async fn get(&self, id: PrimaryKeyOf<Self>) -> Result<Option<Output>, Error>;
 }
 
+/// Opt-in companion to [`CanGetResource`]: a missing row is
+/// [`crate::error::ErrEntityNotFound`] instead of `Ok(None)`.
+///
+/// This is a blanket trait, not a new default provider and not a change
+/// to [`CanGetResource::get`]. Call it only when a transport map should
+/// see `ErrEntityNotFound` (mapped to 404 by `cgp-api`'s REST table).
+pub trait CanGetResourceOrNotFound: CanGetResource {
+    /// Fetch by primary key, raising [`crate::error::ErrEntityNotFound`]
+    /// when the row is absent.
+    fn get_or_not_found(
+        &self,
+        id: PrimaryKeyOf<Self>,
+    ) -> impl core::future::Future<
+        Output = Result<<Self as HasOutputType>::Output, <Self as HasErrorType>::Error>,
+    > + Send
+    where
+        Self: cgp_fork::prelude::CanRaiseError<crate::error::ErrEntityNotFound> + Sync,
+        PrimaryKeyOf<Self>: Send,
+    {
+        async move {
+            match self.get(id).await? {
+                Some(output) => Ok(output),
+                None => Err(Self::raise_error(crate::error::ErrEntityNotFound::of::<
+                    <Self as HasEntityType>::Entity,
+                >())),
+            }
+        }
+    }
+}
+
+impl<T> CanGetResourceOrNotFound for T where T: CanGetResource {}
+
